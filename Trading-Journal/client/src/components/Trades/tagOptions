export const MISTAKE_KEYS  = MISTAKE_TAGS.map(t => t.key);
export const POSITIVE_KEYS = POSITIVE_TAGS.map(t => t.key);

/* key -> { icon, kind: 'bad' | 'good' } */
export const TAG_META = Object.fromEntries([
  ...MISTAKE_TAGS.map(t  => [t.key, { icon: t.icon, kind: 'bad'  }]),
  ...POSITIVE_TAGS.map(t => [t.key, { icon: t.icon, kind: 'good' }]),
]);

export const isMistakeTag = (k) => MISTAKE_KEYS.includes(k);